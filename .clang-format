---
# clang-format configuration for STM32F401 bare-metal C firmware.
# Targets clang-format 14+.  Run: clang-format -i <file>
Language:        Cpp        # covers C as well
BasedOnStyle:    LLVM

# --- Indentation & width ---------------------------------------------------
IndentWidth:            4
ContinuationIndentWidth: 4
ColumnLimit:            100
TabWidth:               4
UseTab:                 Never

# --- Brace placement -------------------------------------------------------
BreakBeforeBraces:      Linux  # function braces on new line, control on same

# --- Spacing ---------------------------------------------------------------
SpaceBeforeParens:          ControlStatements
SpaceInEmptyParentheses:    false
SpaceAfterCStyleCast:       false
SpacesInParentheses:        false
SpacesInSquareBrackets:     false
SpaceBeforeSquareBrackets:  false

# --- Pointer / reference alignment -----------------------------------------
PointerAlignment:       Right   # "uint32_t *ptr", not "uint32_t* ptr"

# --- Include ordering (freestanding C headers first, then project headers) --
# Only stdint.h / stdbool.h / stddef.h and a handful of other freestanding
# headers are permitted in firmware (see CLAUDE.md).
IncludeBlocks:          Regroup
IncludeCategories:
  # Freestanding C headers (the only angle-bracket headers allowed in firmware)
  - Regex:    '^<(stdint|stdbool|stddef|stdarg|limits|float|iso646)\.h>'
    Priority: 1
  # Catch-all for any remaining angle-bracket headers (host tests, tools)
  - Regex:    '^<'
    Priority: 2
  # Project headers (regs/, core/, drivers/, lib/, app/)
  - Regex:    '^"'
    Priority: 3
SortIncludes:           CaseInsensitive

# --- Struct / initialiser alignment ----------------------------------------
AlignConsecutiveMacros:      AcrossEmptyLines
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments:       true

# --- Misc ------------------------------------------------------------------
MaxEmptyLinesToKeep:         2
KeepEmptyLinesAtTheStartOfBlocks: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
ReflowComments:              true
...
